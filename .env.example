# .env.example-ийг .env нэрээр хуулж утгуудаа тохируулна
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/surgaltiin_system

# Урт, санамсаргүй мөр (жишээ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=

# Анхны админ (өгөгдлийн санд админ байхгүй үед л үүснэ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# HTTPS ашиглах үед true болгоно
COOKIE_SECURE=false
# Nginx гэх мэт reverse proxy ард ажиллуулах бол 1
# TRUST_PROXY=1
