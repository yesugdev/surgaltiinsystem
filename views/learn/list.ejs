<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Хичээл</h1>
    <p class="muted"><%= cls ? cls.name + ' анги' : 'Та ангид бүртгэгдээгүй байна' %></p>
  </div>
</div>

<% if (!cls) { %>
  <div class="card empty"><p>Таныг ангид бүртгээгүй тул хичээл харагдахгүй байна. Багш эсвэл админд хандана уу.</p></div>
<% } else if (!groups.length) { %>
  <div class="card empty"><p class="muted">Одоогоор танд хичээл алга байна.</p></div>
<% } else { %>
  <% groups.forEach(function (g) { %>
    <h2 class="group-title"><%= g.name %></h2>
    <div class="exam-grid">
      <% g.lessons.forEach(function (l) { const pct = l.taskCount ? Math.round(l.doneCount / l.taskCount * 100) : null; %>
        <a class="card lesson-card" href="/learn/<%= l._id %>">
          <h3><%= l.title %></h3>
          <% if (l.description) { %><p class="muted small"><%= l.description %></p><% } %>
          <div class="lesson-card-foot">
            <% if (l.taskCount) { %>
              <div class="bar"><span style="width: <%= pct %>%"></span></div>
              <span class="small muted"><%= l.doneCount %> / <%= l.taskCount %> даалгавар</span>
            <% } else { %>
              <span class="small muted">Онол</span>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% }) %>
<% } %>
<%- include('../partials/footer') %>
