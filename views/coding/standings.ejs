<%- include('../partials/header') %>
<% const staffViewer = user.role !== 'student';
   const letter = function (i) { return String.fromCharCode(65 + (i % 26)) + (i >= 26 ? Math.floor(i / 26) : ''); };
   const meRow = rows.find(function (r) { return String(r.student._id) === String(user._id); });
   const ranked = rows.filter(function (r) { return r.rank; });
   const podium = [ranked[1], ranked[0], ranked[2]]; %>
<% if (single && staffViewer) { %>
  <%- include('_manage-head', { problem: single, tab: 'standings' }) %>
<% } else { %>
  <a href="<%= single ? '/coding/' + single._id : '/coding' %>" class="back">← <%= single ? single.title : 'Өрсөлдөөнт Coding' %></a>
<% } %>

<section class="lb-hero">
  <div>
    <h1>🏆 <%= single ? single.title : 'Онооны самбар' %></h1>
    <p><%= single ? 'Энэ бодлогын хамгийн сайн оноогоор' : 'Бүх бодлогын хамгийн сайн онооны нийлбэрээр' %> бүх сурагч хоорондоо өрсөлдөнө. Тэнцвэл оноогоо түрүүлж авсан нь дээр.</p>
  </div>
  <% if (meRow) { %>
    <div class="lb-me tier-<%= meRow.tier.key %>">
      <%- include('_avatar', { look: meRow.look, initials: meRow.student.initials, size: 'lg' }) %>
      <div class="lb-me-body">
        <div class="lb-me-top"><strong><%= meRow.rank ? meRow.rank + '-р байр' : 'Байргүй' %></strong><span class="muted small"> / <%= ranked.length %> оролцогч</span></div>
        <span class="tier-badge"><%= meRow.tier.icon %> <%= meRow.tier.name %></span>
        <% if (meRow.tier.next) { %>
          <div class="tier-progress" title="<%= meRow.tier.points %> rank оноо"><span style="width: <%= meRow.tier.progress %>%"></span></div>
          <span class="small muted"><%= meRow.tier.next.icon %> <%= meRow.tier.next.name %> хүртэл <strong><%= meRow.tier.toNext %></strong> rank оноо (хүнд <%= meRow.tier.hardToNext %> эсвэл хялбар <%= meRow.tier.solvesToNext %> бодлого)</span>
        <% } else { %><span class="small">Хамгийн дээд зэрэглэл! 🎉</span><% } %>
      </div>
    </div>
  <% } %>
</section>

<% if (classes.length > 1) { %>
  <div class="tabs">
    <a href="?" class="<%= !classId ? 'active' : '' %>">🌐 Бүх сурагч</a>
    <% classes.forEach(function (c) { %>
      <a href="?class=<%= c._id %>" class="<%= String(c._id) === classId ? 'active' : '' %>"><%= c.name %></a>
    <% }) %>
  </div>
<% } %>

<% if (!problems.length) { %>
  <div class="card empty"><p>Нийтлэгдсэн бодлого алга байна.</p></div>
<% } else if (!rows.length) { %>
  <div class="card empty"><p class="lb-empty-icon">🚀</p><p><%= classId ? 'Энэ ангид сурагч алга.' : 'Одоогоор хэн ч бодоогүй байна. Эхний оролцогч болоорой!' %></p></div>
<% } else { %>
  <% if (ranked.length) { %>
    <div class="podium" aria-label="Тэргүүлэгчид">
      <% podium.forEach(function (r, i) { const place = [2, 1, 3][i]; %>
        <% if (r) { %>
          <div class="podium-col place-<%= place %> tier-<%= r.tier.key %> <%= String(r.student._id) === String(user._id) ? 'is-me' : '' %>">
            <% if (place === 1) { %><span class="podium-crown" aria-hidden="true">👑</span><% } %>
            <%- include('_avatar', { look: r.look, initials: r.student.initials, size: 'xl' }) %>
            <strong class="podium-name <%= r.look.color ? 'name-' + r.look.color : '' %>"><%= r.student.fullName %></strong>
            <span class="muted small"><%= r.student.className %></span>
            <span class="tier-badge"><%= r.tier.icon %> <%= r.tier.name %></span>
            <div class="podium-block"><span class="podium-medal"><%= place === 1 ? '🥇' : place === 2 ? '🥈' : '🥉' %></span><strong><%= r.total %></strong><small>оноо</small></div>
          </div>
        <% } else { %><div class="podium-col podium-empty place-<%= place %>"></div><% } %>
      <% }) %>
    </div>
  <% } %>

  <section class="card standings-wrap">
    <table class="table standings">
      <thead>
        <tr>
          <th class="num">#</th><th>Сурагч</th><th class="total-col">Нийт оноо</th>
        </tr>
      </thead>
      <tbody>
      <% const maxTotal = Math.max(1, rows[0] ? rows[0].total : 1); %>
      <% rows.forEach(function (r) { const me = String(r.student._id) === String(user._id); %>
        <tr class="<%= me ? 'me' : '' %> tier-<%= r.tier.key %>">
          <td class="num rank-cell"><%= r.rank ? (r.rank === 1 ? '🥇' : r.rank === 2 ? '🥈' : r.rank === 3 ? '🥉' : r.rank) : '—' %></td>
          <td>
            <div class="player">
              <%- include('_avatar', { look: r.look, initials: r.student.initials, size: '' }) %>
              <div>
                <div class="player-name <%= r.look.color ? 'name-' + r.look.color : '' %>"><%= r.student.fullName %><% if (me) { %> <span class="badge badge-blue">та</span><% } %></div>
                <div class="player-meta"><span class="tier-chip" title="<%= r.tier.points %> rank оноо (<%= r.solved %> бүтэн бодсон)"><%= r.tier.icon %> <%= r.tier.name %> · <%= r.tier.points %></span><% if (r.student.className) { %><span class="muted"> · <%= r.student.className %></span><% } %></div>
              </div>
            </div>
          </td>
          <td class="total-cell">
            <strong><%= r.total %></strong> <span class="muted small">оноо</span>
            <div class="total-bar"><span style="width: <%= Math.round(r.total / maxTotal * 100) %>%"></span></div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>
<% } %>

<section class="card tier-legend">
  <h2>Зэрэглэлүүд</h2>
  <p class="muted small">Бодлогыг <strong>бүтэн бодох</strong> (100/100) бүрт хүндийн зэргээр rank оноо авна: <span class="diff-chip diff-easy">🟢 Хялбар 25</span> <span class="diff-chip diff-medium">🟡 Дунд 50</span> <span class="diff-chip diff-hard">🔴 Хүнд 100</span>. Самбарын «Нийт оноо» нь мөн эдгээр оноогоор, хэсэгчилсэн нь хувиар (хүнд бодлогын 60% → 60).</p>
  <div class="tier-list">
    <% TIERS.forEach(function (t) { %>
      <span class="tier-badge tier-<%= t.key %> <%= meRow && meRow.tier.key === t.key ? 'is-current' : '' %>"><%= t.icon %> <%= t.name %> <small><%= t.min %>+ оноо</small></span>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>
