<%- include('../partials/header') %>
<a href="/coding" class="back">← Өрсөлдөөнт Coding</a>

<section class="profile-hero tier-<%= tier.key %>">
  <div class="profile-preview">
    <%- include('_avatar', { look: look, initials: initials, size: 'xl', animate: true }) %>
    <div>
      <h1 class="<%= look.color ? 'name-' + look.color : '' %>"><%= user.fullName %></h1>
      <span class="tier-badge"><%= tier.icon %> <%= tier.name %> · <%= tier.points %> ranking</span>
      <span class="tier-badge">🪙 <%= wallet.balance %> зоос</span>
    </div>
  </div>
  <p class="muted small">Энд таны эзэмшдэг аватар, өнгө харагдана.<% if (lockedCount) { %> Дахиад <%= lockedCount %> зүйлийг <a href="/coding/shop">🛒 дэлгүүрээс</a> зоосоор аваарай!<% } %></p>
</section>

<form method="post" action="/coding/profile" class="form">
  <section class="card">
    <h2>Аватар</h2>
    <div class="cosmetic-grid">
      <label class="cosmetic <%= !selectedAvatar ? 'is-selected' : '' %>">
        <input type="radio" name="avatar" value="" <%= !selectedAvatar ? 'checked' : '' %>>
        <span class="cosmetic-face cosmetic-initials"><%= initials %></span>
        <small>Нэрийн үсэг</small>
      </label>
      <% avatars.forEach(function (a) { %>
        <label class="cosmetic <%= selectedAvatar === a.key ? 'is-selected' : '' %>">
          <input type="radio" name="avatar" value="<%= a.key %>" data-anim="<%= a.anim %>" <%= selectedAvatar === a.key ? 'checked' : '' %>>
          <span class="cosmetic-face"><img class="av-img" src="<%= avatarImg(a.key) %>" alt="" loading="lazy" decoding="async" onerror="this.remove()"><span class="av-face anim-<%= a.anim %>"><%= a.icon %></span></span>
          <small> </small>
        </label>
      <% }) %>
      <a class="cosmetic cosmetic-shop" href="/coding/shop"><span class="cosmetic-face">🛒</span><small>Дэлгүүр</small></a>
    </div>
  </section>

  <section class="card">
    <h2>Өнгө</h2>
    <div class="cosmetic-grid">
      <% colors.forEach(function (c) { %>
        <label class="cosmetic <%= selectedColor === c.key ? 'is-selected' : '' %>">
          <input type="radio" name="color" value="<%= c.key %>" <%= selectedColor === c.key ? 'checked' : '' %>>
          <span class="cosmetic-face cosmetic-swatch <%= c.key === 'tier' ? 'swatch-tier' : 'av-color-' + c.key %>"></span>
          <small><%= c.name %></small>
        </label>
      <% }) %>
    </div>
  </section>

  <div class="btn-group sticky-actions">
    <a class="btn btn-ghost" href="/coding">Буцах</a>
    <button class="btn btn-primary">Хадгалах</button>
  </div>
</form>

<script>
  // Сонголтыг шууд харуулна
  (function () {
    var preview = document.querySelector('.profile-preview .avatar');
    var initials = <%- JSON.stringify(initials) %>;
    document.querySelectorAll('.cosmetic input').forEach(function (input) {
      input.addEventListener('change', function () {
        var group = document.querySelectorAll('input[name="' + input.name + '"]');
        group.forEach(function (g) { g.closest('.cosmetic').classList.toggle('is-selected', g.checked); });
        if (input.name === 'avatar') {
          var face = input.closest('.cosmetic').querySelector('.av-face, .cosmetic-initials').textContent.trim();
          preview.textContent = '';
          if (input.value) {
            var img = document.createElement('img');
            img.className = 'av-img';
            img.src = '/img/avatars/' + input.value + '.webp';
            img.alt = '';
            img.onerror = function () { img.remove(); };
            preview.appendChild(img);
            var span = document.createElement('span');
            span.className = 'av-face anim-' + (input.dataset.anim || 'none');
            span.textContent = face;
            preview.appendChild(span);
          } else preview.textContent = initials;
          preview.classList.toggle('avatar-emoji', !!input.value);
        } else {
          preview.className = preview.className.replace(/\bav-color-\S+/g, '').trim();
          if (input.value !== 'tier') preview.classList.add('av-color-' + input.value);
        }
      });
    });
  })();
</script>
<p class="muted small attribution">Хөдөлгөөнт аватар: <a href="https://googlefonts.github.io/noto-emoji-animation/" target="_blank" rel="noopener">Google Noto Animated Emoji</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a></p>
<%- include('../partials/footer') %>
