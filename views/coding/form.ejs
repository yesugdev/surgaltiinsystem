<%- include('../partials/header', { katex: true }) %>
<% const isNew = !problem._id; const langs = problem.languages || []; %>
<% if (!isNew) { %>
  <%- include('_manage-head', { problem: problem, tab: 'edit' }) %>
<% } else { %>
  <div class="page-head"><div><% if (problem.contest) { %><a href="/coding/contests/<%= problem.contest %>" class="back">← 🏁 Contest</a><% } else if (problem.topic) { %><a href="/cp/topics/<%= problem.topic %>" class="back">← Сэдэв / хичээл рүү</a><% } else { %><a href="/coding" class="back">← Өрсөлдөөнт Coding</a><% } %><h1>Шинэ бодлого</h1></div></div>
<% } %>

<% if (errors.length) { %>
  <div class="flash flash-error"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="<%= isNew ? '/coding/manage' : '/coding/manage/' + problem._id %>" class="form">
  <section class="card form">
    <div class="row">
      <label>Бодлогын нэр <input name="title" value="<%= problem.title || '' %>" required maxlength="200" placeholder="жишээ: Хоёр тооны нийлбэр"></label>
      <label>Хаана
        <select name="topic">
          <option value="">🏆 Үндсэн жагсаалт (бүх сурагч, 🪙 зоос)</option>
          <% if (locals.contests && contests.length) { %>
            <optgroup label="🏁 Contest (ranking оноо)">
              <% contests.forEach(function (c) { %><option value="contest:<%= c._id %>" <%= String(problem.contest || '') === String(c._id) ? 'selected' : '' %>><%= c.kind === 'placement' ? '🎯' : '🏁' %> <%= c.title %></option><% }) %>
            </optgroup>
          <% } %>
          <% [['basics', '🧱 Програмчлалын суурийн хичээл'], ['cp', '🎯 Гүнзгий бэлтгэлийн сэдэв']].forEach(function (g) { const list = topics.filter(function (t) { return (t.track || 'cp') === g[0]; }); if (!list.length) return; %>
            <optgroup label="<%= g[1] %>">
              <% list.forEach(function (t) { %>
                <option value="<%= t._id %>" <%= String(problem.topic || '') === String(t._id) ? 'selected' : '' %>><%= t.icon %> <%= t.title %></option>
              <% }) %>
            </optgroup>
          <% }) %>
        </select>
        <small class="muted">Хичээл/сэдэвтэй бодлого үндсэн самбарт орохгүй: Програмчлалын суурийн бодлого тухайн хичээл нээгдсэн ангид, Гүнзгий бэлтгэлийнх сонгогдсон сурагчдад харагдана.</small>
      </label>
    </div>

    <label for="statement">Өгүүлбэр <span class="muted small">— Markdown + LaTeX ($1 le n le 10^5$)</span></label>
    <textarea name="statement" id="statement" rows="18" data-md-editor data-preview="/coding/manage/preview-statement"
              <%= isNew ? '' : 'data-upload=/coding/manage/' + problem._id + '/attachments' %>
              placeholder="Бодлогын нөхцөл, оролт, гаралтын формат, хязгаарууд"><%= problem.statement || '' %></textarea>
    <p class="muted small">«Оролт», «Гаралт» хэсгүүдийг гарчгаар тусгаарлавал ойлгомжтой. Жишээ тестийг энд бичих шаардлагагүй — тестүүдээс «Жишээ» гэж тэмдэглэсэн нь автоматаар харагдана.<% if (isNew) { %> Зураг оруулах боломж бодлого үүссэний дараа нээгдэнэ.<% } %></p>
  </section>

  <section class="card form">
    <h2>Хүндийн зэрэг</h2>
    <p class="muted small">Сурагч бүтэн бодвол авах оноо. Rank, онооны самбарт үүгээр тооцно.</p>
    <div class="diff-picker" role="radiogroup" aria-label="Хүндийн зэрэг">
      <% Object.values(DIFFICULTIES).forEach(function (d) { %>
        <label class="diff-option diff-<%= d.key %>">
          <input type="radio" name="difficulty" value="<%= d.key %>" <%= (problem.difficulty || 'easy') === d.key ? 'checked' : '' %>>
          <span class="diff-option-icon"><%= d.icon %></span>
          <strong><%= d.label %></strong>
          <span class="diff-option-pts"><%= d.points %> оноо</span>
        </label>
      <% }) %>
    </div>
  </section>

  <section class="card form">
    <h2>Шалгах тохиргоо</h2>
    <div class="row">
      <label>Хугацааны хязгаар (мс) <input type="number" name="timeLimitMs" min="100" max="10000" step="100" value="<%= problem.timeLimitMs %>" required>
        <small class="muted">Нэг тест дээр. Python удаан тул 1000–2000 мс тохиромжтой.</small></label>
      <label>Санах ойн хязгаар (MB) <input type="number" name="memoryLimitMb" min="16" max="1024" value="<%= problem.memoryLimitMb %>" required></label>
    </div>
    <fieldset>
      <legend>Зөвшөөрөх хэл</legend>
      <div class="checks">
        <% Object.keys(LANGUAGES).forEach(function (k) { %>
          <label class="check"><input type="checkbox" name="languages" value="<%= k %>" <%= langs.includes(k) ? 'checked' : '' %>> <%= LANGUAGES[k].label %></label>
        <% }) %>
      </div>
    </fieldset>
  </section>

  <section class="card form">
    <h2>Хугацаа</h2>
    <p class="muted small">Нийтлэгдсэн бодлогыг бүх сурагч бодож, нэг онооны самбарт хоорондоо өрсөлдөнө.</p>
    <div class="row">
      <label>Эхлэх <small class="muted">(заавал биш)</small> <input type="datetime-local" name="startAt" value="<%= toInputDate(problem.startAt) %>"></label>
      <label>Дуусах <small class="muted">(заавал биш)</small> <input type="datetime-local" name="endAt" value="<%= toInputDate(problem.endAt) %>"></label>
    </div>
    <label class="check"><input type="checkbox" name="showStandings" <%= problem.showStandings ? 'checked' : '' %>> Сурагчдад онооны самбарт харуулах</label>
  </section>

  <div class="btn-group sticky-actions">
    <a class="btn btn-ghost" href="<%= isNew ? (problem.topic ? '/cp/topics/' + problem.topic : '/coding') : '/coding/manage/' + problem._id %>">Болих</a>
    <button class="btn btn-primary"><%= isNew ? 'Үүсгээд тест оруулах →' : 'Хадгалах' %></button>
  </div>
</form>

<% if (!isNew) { %>
  <section class="card danger-zone">
    <h2>Бодлого устгах</h2>
    <p class="muted small">Бүх тест, сурагчдын илгээлт хамт устна.</p>
    <form method="post" action="/coding/manage/<%= problem._id %>/delete" onsubmit="return confirm('Бодлого, бүх тест, илгээлтийг устгах уу?')">
      <button class="btn btn-danger">Устгах</button>
    </form>
  </section>
<% } %>
<%- include('../partials/footer', { scripts: ['/js/md-editor.js'] }) %>
