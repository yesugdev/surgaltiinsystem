<%# Аватар: look = { avatar: emoji|null, img, anim, color }, initials, size = '' | 'lg' | 'xl', animate
    Хөдөлгөөнт зураг (Noto Animated Emoji); ачаалагдаагүй эсвэл «хөдөлгөөн багасгах» үед emoji + CSS хөдөлгөөн %>
<% const lk = locals.look || {}; %>
<span class="avatar <%= locals.size ? 'avatar-' + size : '' %> <%= lk.color ? 'av-color-' + lk.color : '' %> <%= lk.avatar ? 'avatar-emoji' : '' %> <%= locals.animate ? 'is-animated' : '' %>" aria-hidden="true"><% if (lk.avatar) { %><% if (lk.img) { %><img class="av-img" src="<%= lk.img %>" alt="" loading="lazy" decoding="async" onerror="this.remove()"><% } %><span class="av-face anim-<%= lk.anim || 'none' %>"><%= lk.avatar %></span><% } else { %><%= locals.initials || '?' %><% } %></span>
