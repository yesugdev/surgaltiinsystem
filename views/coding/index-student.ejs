<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Өрсөлдөөнт Coding</h1>
    <p class="muted">Бодлого бодож 🪙 зоос цуглуулаад дэлгүүрээс аватар аваарай. Зэрэглэл 🏅 зөвхөн <strong>contest</strong>-оор ахина!</p>
  </div>
  <div class="btn-group">
    <a href="/coding/contests" class="btn">🏁 Contest</a>
    <a href="/coding/standings" class="btn">🏆 Rank самбар</a>
  </div>
</div>

<% contests.forEach(function (c) { %>
  <a class="contest-banner is-<%= c.state %>" href="/coding/contests/<%= c._id %>">
    <span class="contest-banner-icon"><%= c.kind === 'placement' ? '🎯' : '🏁' %></span>
    <span>
      <strong><%= c.state === 'running' ? 'Contest явагдаж байна: ' : 'Удахгүй: ' %><%= c.title %></strong>
      <span class="small"> · <%= c.state === 'running' ? 'дуусах ' + fmtDate(c.endAt) : 'эхлэх ' + fmtDate(c.startAt) %><%= c.kind === 'placement' ? ' · түвшин тогтоох' : '' %></span>
    </span>
    <span class="contest-banner-go"><%= c.state === 'running' ? 'Оролцох →' : 'Харах →' %></span>
  </a>
<% }) %>

<section class="rank-hero tier-<%= me.tier.key %>">
  <div class="rank-main">
    <a class="rank-avatar" href="/coding/profile" title="Аватар солих">
      <%- include('_avatar', { look: me.look, initials: me.initials, size: 'xl', animate: true }) %>
      <span class="rank-avatar-badge" aria-hidden="true"><%= me.tier.icon %></span>
    </a>
    <div>
      <span class="muted small">Таны зэрэглэл · <%= me.tier.level %>-р түвшин · <a href="/coding/profile">🎨 Аватар</a></span>
      <h2 class="rank-name"><%= me.tier.name %></h2>
      <% if (me.tier.next) { %>
        <div class="tier-progress"><span style="width: <%= me.tier.progress %>%"></span></div>
        <span class="small"><%= me.tier.next.icon %> <strong><%= me.tier.next.name %></strong> хүртэл <%= me.tier.toNext %> ranking оноо — contest-д оролцоорой!</span>
      <% } else { %><span class="small">Та хамгийн дээд зэрэглэлд хүрсэн! 🎉</span><% } %>
      <% if (!me.placementDone) { %><span class="small muted rank-hint">🎯 Түвшин тогтоох contest-д оролцож эхлэх зэрэглэлээ аваарай.</span><% } %>
    </div>
  </div>
  <div class="rank-stats">
    <div title="Зөвхөн contest-оор нэмэгдэнэ"><strong><%= me.tier.points %></strong><span>🏅 ranking</span></div>
    <div><strong><%= me.rank ? '#' + me.rank : '—' %></strong><span><%= me.players %> сурагчаас</span></div>
    <a class="rank-coins" href="/coding/shop" title="Бодсон бодлогын оноо — дэлгүүрт зарцуулна"><strong>🪙 <%= me.wallet.balance %></strong><span>зоос · 🛒 Дэлгүүр</span></a>
  </div>
  <% if (top.length) { %>
    <a class="rank-top" href="/coding/standings">
      <span class="muted small">Тэргүүлэгчид</span>
      <% top.forEach(function (r, i) { %>
        <span class="rank-top-row"><%= ['🥇', '🥈', '🥉'][i] %> <%= r.student.fullName %> <b><%= r.student.ratingPoints %></b></span>
      <% }) %>
    </a>
  <% } %>
</section>

<% if (locals.canCp) { %>
  <a class="cp-banner" href="/cp">
    <span class="cp-banner-icon">🎯</span>
    <span><strong>Гүнзгий бэлтгэл нээлттэй!</strong><span class="muted small"> Олимпиадын сэдвүүдийг онолтой нь, сэдэв тус бүрийн бодлоготой нь судлаарай.</span></span>
    <span class="cp-banner-go">Орох →</span>
  </a>
<% } %>

<% if (!problems.length) { %>
  <div class="card empty"><p>Одоогоор бодлого алга байна.</p></div>
<% } else { %>
  <section class="card problem-list-card">
    <div class="problem-list-head">
      <span>№</span><span>Бодлого</span><span>Миний оноо 🪙</span><span>Төлөв</span>
    </div>
    <ol class="problem-list">
      <% problems.forEach(function (p) { const m = p.mine; const done = m && m.best === 100; const tag = p.phase === 'upcoming' ? 'div' : 'a'; %>
        <li>
          <<%= tag %> class="problem-row <%= done ? 'is-solved' : m ? 'is-tried' : '' %> <%= p.phase === 'upcoming' ? 'is-upcoming' : '' %>" <%- tag === 'a' ? 'href="/coding/' + p._id + '"' : '' %>>
            <span class="problem-num"><%= p.number || '—' %></span>
            <span class="problem-main">
              <strong class="problem-title"><%= p.title %></strong>
              <span class="muted small">
                <% if (p.phase === 'upcoming') { %>Эхлэх: <%= fmtDate(p.startAt) %>
                <% } else { const d = codingDiff(p.difficulty); %><span class="diff-chip diff-<%= d.key %>"><%= d.icon %> <%= d.label %> · <%= d.points %></span> ⏱ <%= p.timeLimitMs / 1000 %> сек<% if (m) { %> · <%= m.attempts %> оролдлого<% } %><% if (p.endAt && p.phase === 'open') { %> · дуусах: <%= fmtDate(p.endAt) %><% } %><% } %>
              </span>
            </span>
            <span class="problem-score">
              <% if (m) { %><b><%= codingPts(m.best, p.difficulty) %></b><small>/<%= codingDiff(p.difficulty).points %></small><% } else { %><span class="muted small">—</span><% } %>
              <span class="score-bar" aria-hidden="true"><span style="width: <%= m ? m.best : 0 %>%"></span></span>
            </span>
            <span class="problem-status">
              <% if (p.phase === 'upcoming') { %><span class="badge badge-blue">Эхлээгүй</span>
              <% } else if (done) { %><span class="badge badge-green">✓ Бодсон</span>
              <% } else if (m) { %><span class="badge badge-amber">Дутуу</span>
              <% } else if (p.phase === 'closed') { %><span class="badge">Дууссан</span>
              <% } else { %><span class="badge badge-outline">Бодох →</span><% } %>
            </span>
          </<%= tag %>>
        </li>
      <% }) %>
    </ol>
    <%- include('_pager') %>
  </section>
<% } %>
<% if (rankUp) { %><div id="rank-up-data" data-json="<%= JSON.stringify(rankUp) %>" hidden></div><% } %>
<%- include('../partials/footer', { scripts: ['/celebrate.js'] }) %>
