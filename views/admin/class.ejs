<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <a href="/admin/classes" class="back">← Анги, бүлэг</a>
    <h1><%= cls.name %></h1>
    <p class="muted"><%= cls.schoolYear || '' %> · <%= students.length %> сурагч</p>
  </div>
  <div class="btn-group">
    <form method="post" action="/admin/classes/<%= cls._id %>/coding">
      <input type="hidden" name="back" value="class">
      <button class="switch <%= cls.codingEnabled ? 'on' : '' %>" role="switch" aria-checked="<%= cls.codingEnabled ? 'true' : 'false' %>">
        <span class="switch-knob" aria-hidden="true"></span><span class="switch-label">💻 Өрсөлдөөнт Coding: <%= cls.codingEnabled ? 'Нээлттэй' : 'Хаалттай' %></span>
      </button>
    </form>
    <form method="post" action="/admin/classes/<%= cls._id %>/delete"
          data-confirm="«<%= cls.name %>» ангийг устгах уу? Сурагчид устахгүй, бусад ангидаа хэвээр үлдэнэ.">
      <button class="btn btn-danger">Анги устгах</button>
    </form>
  </div>
</div>

<div class="grid-2">
  <section class="card">
    <h2>Сурагч нэмэх</h2>
    <form method="post" action="/admin/classes/<%= cls._id %>/students" class="form">
      <label>Овог нэр <input name="fullName" required maxlength="150"></label>
      <div class="row">
        <label>Нэвтрэх нэр <input name="username" placeholder="хоосон бол автомат" maxlength="32" autocapitalize="none"></label>
        <label>Нууц үг <input name="password" placeholder="хоосон бол автомат" maxlength="64"></label>
      </div>
      <input type="hidden" name="prefix" value="<%= bulkPrefix %>">
      <button class="btn btn-primary">Нэмэх</button>
    </form>
  </section>

  <section class="card">
    <h2>Ангийн мэдээлэл</h2>
    <form method="post" action="/admin/classes/<%= cls._id %>" class="form">
      <div class="row">
        <label>Нэр <input name="name" value="<%= cls.name %>" required maxlength="100"></label>
        <label>Хичээлийн жил <input name="schoolYear" value="<%= cls.schoolYear || '' %>" maxlength="20"></label>
      </div>
      <label>Тайлбар <textarea name="description" rows="2" maxlength="2000"><%= cls.description || '' %></textarea></label>
      <button class="btn">Хадгалах</button>
    </form>
  </section>
</div>

<section class="card" id="bulk">
  <h2>Олон сурагч нэг дор нэмэх</h2>
  <p class="muted small">Мөр бүрт нэг сурагч. Формат: <code>Овог нэр</code>, эсвэл <code>Овог нэр, нэвтрэх нэр</code>, эсвэл <code>Овог нэр, нэвтрэх нэр, нууц үг</code>.
    Excel-ээс хуулж буулгаж болно. Нэвтрэх нэр, нууц үгийг хоосон орхивол систем үүсгэнэ.</p>
  <% if (bulkErrors.length) { %>
    <div class="flash flash-error">
      <strong>Нэг ч сурагч нэмэгдсэнгүй. Дараах алдааг засна уу:</strong>
      <ul><% bulkErrors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
    </div>
  <% } %>
  <form method="post" action="/admin/classes/<%= cls._id %>/students/bulk" class="form">
    <textarea name="lines" rows="8" placeholder="Бат Болд&#10;Дорж Сарнай, sarnai10a&#10;Ганбаатар Тэмүүлэн, temuulen, nuuts123"><%= bulkText %></textarea>
    <div class="row row-end">
      <label>Автомат нэвтрэх нэрийн угтвар
        <input name="prefix" value="<%= bulkPrefix %>" maxlength="16" autocapitalize="none">
        <small class="muted">жишээ: <code>10a</code> → 10a001, 10a002…</small>
      </label>
      <button class="btn btn-primary">Бүгдийг нэмэх</button>
    </div>
  </form>
</section>

<section class="card" id="members">
  <h2>Бүртгэлтэй сурагчдаас сонгож нэмэх</h2>
  <p class="muted small">Өөр анги, бүлэгт бүртгэлтэй сурагчдыг энэ ангид нэмнэ. Сурагчийн өмнөх ангиуд хэвээр үлдэх тул нэг сурагч хэд хэдэн ангид зэрэг байж болно.</p>
  <% if (!others.length) { %>
    <p class="muted">Нэмэх боломжтой сурагч алга.</p>
  <% } else { %>
    <form method="post" action="/admin/classes/<%= cls._id %>/members" class="form" id="member-picker">
      <div class="row row-end">
        <label>Хайх <input type="search" id="mp-q" placeholder="Нэр эсвэл нэвтрэх нэр" autocomplete="off"></label>
        <label>Ангиар шүүх
          <select id="mp-class">
            <option value="">Бүх анги</option>
            <option value="-">Ангигүй</option>
            <% otherClasses.forEach(function (c) { %><option value="<%= c.name %>"><%= c.name %></option><% }) %>
          </select>
        </label>
      </div>
      <div class="mp-tools">
        <label class="check"><input type="checkbox" id="mp-all"> Харагдаж буй бүгдийг сонгох</label>
        <span class="muted small"><b id="mp-count">0</b> сонгосон</span>
      </div>
      <div class="mp-list">
        <% others.forEach(function (s) { const cn = s.classNames.join(', '); %>
          <label class="check mp-item" data-text="<%= (s.fullName + ' ' + s.username).toLowerCase() %>" data-classes="<%= s.classNames.length ? '|' + s.classNames.join('|') + '|' : '-' %>">
            <input type="checkbox" name="studentIds" value="<%= s._id %>">
            <span><%= s.fullName %> <code class="small"><%= s.username %></code><% if (cn) { %> <span class="muted small">· <%= cn %></span><% } else { %> <span class="muted small">· ангигүй</span><% } %></span>
          </label>
        <% }) %>
      </div>
      <button class="btn btn-primary" id="mp-submit" disabled>Сонгосон сурагчдыг нэмэх</button>
    </form>
    <script>
      (function () {
        var form = document.getElementById('member-picker');
        var q = document.getElementById('mp-q'), sel = document.getElementById('mp-class'), all = document.getElementById('mp-all');
        var items = Array.prototype.slice.call(form.querySelectorAll('.mp-item'));
        var count = document.getElementById('mp-count'), btn = document.getElementById('mp-submit');
        function visible() { return items.filter(function (el) { return !el.hidden; }); }
        function update() {
          var n = form.querySelectorAll('input[name="studentIds"]:checked').length;
          count.textContent = n; btn.disabled = !n;
          btn.textContent = n ? n + ' сурагчийг нэмэх' : 'Сонгосон сурагчдыг нэмэх';
          var vis = visible();
          all.checked = vis.length > 0 && vis.every(function (el) { return el.querySelector('input').checked; });
        }
        function filter() {
          var t = q.value.trim().toLowerCase(), c = sel.value;
          items.forEach(function (el) {
            var okT = !t || el.dataset.text.indexOf(t) >= 0;
            var okC = !c || (c === '-' ? el.dataset.classes === '-' : el.dataset.classes.indexOf('|' + c + '|') >= 0);
            el.hidden = !(okT && okC);
          });
          update();
        }
        q.addEventListener('input', filter); sel.addEventListener('change', filter);
        all.addEventListener('change', function () { visible().forEach(function (el) { el.querySelector('input').checked = all.checked; }); update(); });
        form.addEventListener('change', function (e) { if (e.target.name === 'studentIds') update(); });
      })();
    </script>
  <% } %>
</section>

<section class="card">
  <h2>Сурагчид (<%= students.length %>)</h2>
  <% if (!students.length) { %>
    <p class="muted">Энэ ангид сурагч бүртгэгдээгүй байна.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th class="num">#</th><th>Овог нэр</th><th>Нэвтрэх нэр</th><th>Төлөв</th><th></th></tr></thead>
      <tbody>
      <% students.forEach(function (s, i) { %>
        <tr class="<%= s.active ? '' : 'inactive' %>">
          <td class="num muted"><%= i + 1 %></td>
          <td><a href="/profile/<%= s._id %>" title="Профайл, явц"><%= s.fullName %></a><% if (s.otherClasses.length) { %><div class="muted small">+ <%= s.otherClasses.join(', ') %></div><% } %></td>
          <td><code><%= s.username %></code></td>
          <td><% if (s.active) { %><span class="badge badge-green">Идэвхтэй</span><% } else { %><span class="badge">Идэвхгүй</span><% } %></td>
          <td class="actions">
            <a class="btn btn-sm" href="/admin/users/<%= s._id %>">Засах</a>
            <form method="post" action="/admin/classes/<%= cls._id %>/members/<%= s._id %>/remove" class="inline" data-confirm="<%= s.fullName %>-г «<%= cls.name %>»-аас хасах уу? Хэрэглэгч устахгүй.">
              <button class="btn btn-sm btn-ghost" title="Энэ ангиас хасах">Хасах</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  <% } %>
</section>
<%- include('../partials/footer') %>
