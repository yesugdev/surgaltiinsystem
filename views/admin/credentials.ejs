<%- include('../partials/header') %>
<div class="page-head no-print">
  <div>
    <a href="/admin/classes/<%= cls._id %>" class="back">← <%= cls.name %></a>
    <h1><%= credentials.length %> сурагч нэмэгдлээ</h1>
    <p class="muted">Нууц үгийг зөвхөн одоо харах боломжтой. Хэвлэж эсвэл хадгалж аваад сурагчдад тараана уу.</p>
  </div>
  <button class="btn btn-primary" onclick="window.print()">Хэвлэх</button>
</div>

<div class="print-only"><h2><%= cls.name %> — нэвтрэх мэдээлэл</h2></div>
<div class="cred-grid">
  <% credentials.forEach(function (c) { %>
    <div class="cred card">
      <div class="cred-name"><%= c.fullName %></div>
      <div class="muted small"><%= cls.name %></div>
      <div class="cred-row"><span>Нэвтрэх нэр</span><code><%= c.username %></code></div>
      <div class="cred-row"><span>Нууц үг</span><code><%= c.password %></code></div>
    </div>
  <% }) %>
</div>
<%- include('../partials/footer') %>
