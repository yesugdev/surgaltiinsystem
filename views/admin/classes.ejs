<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Анги, бүлэг</h1>
    <p class="muted">Нийт <%= classes.length %> анги</p>
  </div>
</div>

<div class="grid-side">
  <section class="card">
    <% if (!classes.length) { %>
      <div class="empty"><p class="muted">Одоогоор анги бүртгэгдээгүй байна. Баруун талын маягтаар эхний ангиа нэмнэ үү.</p></div>
    <% } else { %>
      <div class="import-toolbar coding-bulk">
        <span class="small muted">💻 Өрсөлдөөнт Coding: <strong><%= classes.filter(function (c) { return c.codingEnabled; }).length %></strong> / <%= classes.length %> ангид нээлттэй</span>
        <div class="btn-group">
          <form method="post" action="/admin/classes/coding-all"><input type="hidden" name="enable" value="1"><button class="btn btn-sm">Бүгдэд нээх</button></form>
          <form method="post" action="/admin/classes/coding-all" data-confirm="Бүх ангид Өрсөлдөөнт Coding-ийг хаах уу?"><input type="hidden" name="enable" value="0"><button class="btn btn-sm btn-ghost">Бүгдэд хаах</button></form>
        </div>
      </div>
      <table class="table">
        <thead><tr><th>Анги</th><th>Хичээлийн жил</th><th class="num">Сурагч</th><th>Өрсөлдөөнт Coding</th><th></th></tr></thead>
        <tbody>
        <% classes.forEach(function (c) { %>
          <tr>
            <td><a href="/admin/classes/<%= c._id %>"><strong><%= c.name %></strong></a>
              <% if (c.description) { %><div class="muted small"><%= c.description %></div><% } %></td>
            <td><%= c.schoolYear || '—' %></td>
            <td class="num"><%= c.studentCount %></td>
            <td>
              <form method="post" action="/admin/classes/<%= c._id %>/coding">
                <button class="switch <%= c.codingEnabled ? 'on' : '' %>" role="switch" aria-checked="<%= c.codingEnabled ? 'true' : 'false' %>" title="<%= c.codingEnabled ? 'Хаах' : 'Нээх' %>">
                  <span class="switch-knob" aria-hidden="true"></span><span class="switch-label"><%= c.codingEnabled ? 'Нээлттэй' : 'Хаалттай' %></span>
                </button>
              </form>
            </td>
            <td class="actions"><a class="btn btn-sm" href="/admin/classes/<%= c._id %>">Нээх</a></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <section class="card">
    <h2>Шинэ анги</h2>
    <form method="post" action="/admin/classes" class="form">
      <label>Ангийн нэр <input name="name" placeholder="жишээ: 10А" required maxlength="100"></label>
      <label>Хичээлийн жил <input name="schoolYear" placeholder="2026-2027" maxlength="20"></label>
      <label>Тайлбар <textarea name="description" rows="2" maxlength="2000"></textarea></label>
      <button class="btn btn-primary">Нэмэх</button>
    </form>
  </section>
</div>
<%- include('../partials/footer') %>
