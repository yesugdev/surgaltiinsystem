<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Сайн байна уу, <%= user.fullName %>!</h1>
    <p class="muted"><%= cls ? cls.name + ' анги' : 'Та ангид бүртгэгдээгүй байна' %></p>
  </div>
</div>

<% if (!cls) { %>
  <div class="card empty"><p>Таныг ангид бүртгээгүй тул шалгалт харагдахгүй байна. Багш эсвэл админд хандана уу.</p></div>
<% } else if (!exams.length) { %>
  <div class="card empty"><p class="muted">Одоогоор танд шалгалт алга байна.</p></div>
<% } else { %>
  <div class="exam-grid">
  <% exams.forEach(function (e) { const a = e.attempt; %>
    <article class="card exam-card status-<%= e.status %>">
      <div class="exam-card-head">
        <h3><%= e.title %></h3>
        <% if (e.status === 'open') { %><span class="badge badge-green">Нээлттэй</span>
        <% } else if (e.status === 'in_progress') { %><span class="badge badge-blue">Үргэлжилж байна</span>
        <% } else if (e.status === 'upcoming') { %><span class="badge badge-amber">Удахгүй</span>
        <% } else if (e.status === 'submitted') { %><span class="badge">Өгсөн</span>
        <% } else { %><span class="badge">Хаагдсан</span><% } %>
      </div>
      <ul class="meta">
        <% if (e.subjectName) { %><li><span class="badge badge-blue"><%= e.subjectName %></span></li><% } %>
        <li><%= e.questionCount %> асуулт · <%= fmtScore(e.maxScore) %> оноо</li>
        <li>Хугацаа: <%= e.durationMinutes %> минут</li>
        <% if (e.startAt) { %><li>Нээгдэх: <%= fmtDate(e.startAt) %></li><% } %>
        <% if (e.endAt) { %><li>Хаагдах: <%= fmtDate(e.endAt) %></li><% } %>
      </ul>

      <% if (e.status === 'open') { %>
        <form method="post" action="/student/exams/<%= e._id %>/start"
              data-confirm="Шалгалтыг эхлүүлэх үү? Эхэлсний дараа <%= e.durationMinutes %> минутын хугацаа тоологдож эхэлнэ.">
          <button class="btn btn-primary btn-block">Шалгалт эхлүүлэх</button>
        </form>
      <% } else if (e.status === 'in_progress') { %>
        <a class="btn btn-primary btn-block" href="/student/attempts/<%= a._id %>">Үргэлжлүүлэх</a>
      <% } else if (e.status === 'submitted') { %>
        <a class="btn btn-block" href="/student/attempts/<%= a._id %>/result">
          <% if (e.showResults) { %>
            <%= a.needsReview ? 'Дүгнэгдэж байна' : 'Оноо: ' + fmtScore(a.score) + ' / ' + fmtScore(a.maxScore) %>
          <% } else { %>Илгээсэн<% } %>
        </a>
      <% } else if (e.status === 'upcoming') { %>
        <button class="btn btn-block" disabled><%= fmtDate(e.startAt) %>-д нээгдэнэ</button>
      <% } else { %>
        <button class="btn btn-block" disabled>Хугацаа дууссан</button>
      <% } %>
    </article>
  <% }) %>
  </div>
<% } %>
<%- include('../partials/footer') %>
