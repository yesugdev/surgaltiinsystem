<%- include('../partials/header') %>
<% const isNew = !task._id; const isQuiz = task.type === 'quiz'; const b = '/lessons/' + lesson._id; %>
<div class="page-head">
  <div>
    <a href="<%= b %>#tasks" class="back">← <%= lesson.title %></a>
    <h1><%= isNew ? (isQuiz ? 'Тест нэмэх' : 'Даалгавар нэмэх') : (isQuiz ? 'Тест засах' : 'Даалгавар засах') %></h1>
    <p class="muted"><%= isQuiz ? 'Зөв, буруу хариултаар автоматаар дүгнэгдэнэ.' : 'Сурагч файл (Word, PDF, зураг…) илгээж, багш оноо өгнө.' %></p>
  </div>
</div>

<% if (errors.length) { %>
  <div class="flash flash-error"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>

<form method="post" action="<%= isNew ? b + '/tasks' : b + '/tasks/' + task._id %>" class="form">
  <input type="hidden" name="type" value="<%= task.type %>">
  <section class="card form">
    <label>Нэр <input name="title" value="<%= task.title %>" required maxlength="200" placeholder="<%= isQuiz ? 'жишээ: Бататгах тест' : 'жишээ: Бие даалт' %>"></label>

    <div class="md-field">
      <label for="instructions"><%= isQuiz ? 'Заавар (заавал биш)' : 'Даалгаврын заавар' %> <small class="muted">— Markdown</small></label>
      <div class="md-split">
        <textarea name="instructions" id="instructions" rows="<%= isQuiz ? 3 : 10 %>" data-md-preview="#instr-preview" maxlength="50000"
                  placeholder="<%= isQuiz ? 'Сурагчдад харагдах товч заавар' : 'Юу хийх, ямар хэлбэрээр илгээх, үнэлэх шалгуур...' %>"><%= task.instructions %></textarea>
        <div class="markdown md-preview-box" id="instr-preview"></div>
      </div>
    </div>

    <% if (!isQuiz) { %>
      <div class="row">
        <label>Дээд оноо <input type="number" name="maxPoints" min="0.5" max="1000" step="0.5" value="<%= task.maxPoints %>" required></label>
        <label>Илгээх хугацаа <input type="datetime-local" name="dueAt" value="<%= toInputDate(task.dueAt) %>"></label>
      </div>
      <label class="check"><input type="checkbox" name="allowLate" <%= task.allowLate ? 'checked' : '' %>> Хугацаа хэтэрсэн ч илгээхийг зөвшөөрөх (хоцорсон гэж тэмдэглэгдэнэ)</label>
    <% } else { %>
      <div class="checks">
        <label class="check"><input type="checkbox" name="allowRetry" <%= task.allowRetry ? 'checked' : '' %>> Дахин өгөхийг зөвшөөрөх (сүүлийн оролдлого тооцогдоно)</label>
        <label class="check"><input type="checkbox" name="showAnswers" <%= task.showAnswers ? 'checked' : '' %>> Илгээсний дараа зөв хариултыг харуулах</label>
      </div>
    <% } %>
  </section>

  <% if (isQuiz) { %>
    <section class="card">
      <div class="import-toolbar">
        <h2>Асуултууд</h2>
        <span id="questions-summary" class="small muted"></span>
      </div>
      <% if (locked) { %>
        <div class="flash flash-info">Сурагчид энэ тестийг өгсөн тул асуултыг өөрчлөх боломжгүй (нэр, заавар, тохиргоог өөрчилж болно). Өөрчлөх шаардлагатай бол «Гүйцэтгэл» хуудаснаас сурагчдын гүйцэтгэлийг устгана уу.</div>
      <% } else { %>
        <p class="muted small">Шалгалтын асуултын формат: <code>1. Асуулт</code>, <code>A) сонголт</code>, зөв сонголтын өмнө <code>*</code>, нээлттэй асуултад <code>Хариулт: …</code>, <code>Оноо: 2</code>.</p>
      <% } %>
      <div class="import-layout">
        <textarea name="questionsText" id="questions-text" rows="18" spellcheck="false" <%= locked ? 'readonly' : '' %>
                  placeholder="1. Асуултын текст&#10;A) Сонголт&#10;*B) Зөв сонголт&#10;C) Сонголт&#10;&#10;2. Нээлттэй асуулт&#10;Хариулт: Зөв хариулт"><%= questionsText %></textarea>
        <div class="preview-list" id="questions-preview"></div>
      </div>
    </section>
  <% } %>

  <div class="btn-group">
    <button class="btn btn-primary">Хадгалах</button>
    <a class="btn btn-ghost" href="<%= b %>#tasks">Болих</a>
  </div>
</form>
<%- include('../partials/footer', { scripts: ['/question-parser.js', '/preview.js', '/task-form.js'] }) %>
