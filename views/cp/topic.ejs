<%- include('../partials/header') %>
<a href="/cp" class="back">← 🎯 Гүнзгий бэлтгэл</a>
<div class="page-head">
  <div>
    <p class="muted small cp-crumb"><%= section.icon %> <%= section.name %></p>
    <h1><span class="cp-title-icon"><%= topic.icon %></span> <%= topic.title %>
      <% if (!topic.published) { %><span class="badge badge-amber">Ноорог</span><% } %></h1>
    <% if (topic.summary) { %><p class="muted"><%= topic.summary %></p><% } %>
  </div>
  <% if (staff) { %>
    <div class="btn-group">
      <a class="btn" href="/cp/topics/<%= topic._id %>/edit">✎ Онол, тохиргоо</a>
      <a class="btn btn-primary" href="/coding/manage/new?topic=<%= topic._id %>">+ Бодлого нэмэх</a>
    </div>
  <% } %>
</div>

<div class="cp-topic-layout">
  <article class="card cp-theory">
    <h2 class="cp-block-title">📖 Онол</h2>
    <% if (topic.theory.trim()) { %>
      <div class="markdown"><%- theoryHtml %></div>
    <% } else { %>
      <p class="muted">Онол хараахан оруулаагүй байна.<% if (staff) { %> <a href="/cp/topics/<%= topic._id %>/edit">Онол бичих →</a><% } %></p>
    <% } %>
  </article>

  <aside class="cp-side">
    <% if (toc.length > 1) { %>
      <nav class="card cp-toc" aria-label="Агуулга">
        <strong class="small">Агуулга</strong>
        <% toc.forEach(function (h) { %><a class="toc-l<%= h.level %>" href="#<%= h.id %>"><%= h.text %></a><% }) %>
      </nav>
    <% } %>

    <section class="card cp-problems">
      <h2 class="cp-block-title">🧩 Бодлогууд</h2>
      <% if (!problems.length) { %>
        <p class="muted small">Бодлого хараахан алга.<% if (staff) { %> <a href="/coding/manage/new?topic=<%= topic._id %>">Нэмэх →</a><% } %></p>
      <% } else { %>
        <ol class="cp-problem-list">
          <% problems.forEach(function (p) { %>
            <li class="<%= p.solved ? 'is-solved' : '' %>">
              <a href="/coding/<%= p._id %>">
                <span class="cp-p-num"><%= p.solved ? '✓' : p.n %></span>
                <span class="cp-p-title"><%= p.title %></span>
                <span class="diff-chip diff-<%= p.diff.key %>"><%= p.diff.icon %> <%= p.diff.label %></span>
              </a>
              <% if (staff) { %>
                <span class="cp-p-staff small">
                  <% if (!p.published) { %><span class="badge badge-amber">Ноорог</span><% } %>
                  <% if (!p.testCount) { %><span class="badge badge-amber">тестгүй</span><% } %>
                  <% if (p.canEdit) { %><a href="/coding/manage/<%= p._id %>">удирдах</a><% } %>
                </span>
              <% } %>
            </li>
          <% }) %>
        </ol>
      <% } %>
    </section>

    <% if (chapters.length) { %>
      <section class="card cp-book-links">
        <h2 class="cp-block-title">📕 Номоос унших</h2>
        <% chapters.forEach(function (c) { %>
          <a href="/cp/book?ch=<%= c.n %>"><span class="cp-book-n"><%= c.n %></span> <%= c.title %> <span class="muted small">х. <%= c.page %></span></a>
        <% }) %>
      </section>
    <% } %>

    <section class="card cp-my-notes" id="my-notes">
      <h2 class="cp-block-title">📝 Миний тэмдэглэл</h2>
      <% notes.forEach(function (n) { %>
        <details class="cp-note-mini">
          <summary><%= n.title || 'Гарчиггүй тэмдэглэл' %> <span class="muted small">· <%= fmtDate(n.updatedAt) %></span></summary>
          <div class="markdown small"><%- n.html %></div>
          <a class="small" href="/cp/notes/<%= n._id %>/edit">✎ Засах</a>
        </details>
      <% }) %>
      <form method="post" action="/cp/notes" class="cp-quick-note">
        <input type="hidden" name="topic" value="<%= topic._id %>">
        <input type="hidden" name="quick" value="1">
        <input type="hidden" name="back" value="/cp/topics/<%= topic._id %>#my-notes">
        <input name="title" maxlength="200" placeholder="Гарчиг (заавал биш)">
        <textarea name="body" rows="3" maxlength="50000" placeholder="Энэ сэдвээс юу ойлгосон, юунд анхаарах вэ…"></textarea>
        <div class="btn-group">
          <button class="btn btn-sm btn-primary">Хадгалах</button>
          <a class="btn btn-sm btn-ghost" href="/cp/notes/new?topic=<%= topic._id %>">Дэлгэрэнгүй засварлагч</a>
        </div>
      </form>
      <a class="small" href="/cp/notes?topic=<%= topic._id %>">Бүх тэмдэглэл →</a>
    </section>
  </aside>
</div>

<nav class="cp-pager">
  <% if (prev) { %><a class="btn" href="/cp/topics/<%= prev._id %>">← <%= prev.icon %> <%= prev.title %></a><% } else { %><span></span><% } %>
  <% if (next) { %><a class="btn" href="/cp/topics/<%= next._id %>"><%= next.icon %> <%= next.title %> →</a><% } %>
</nav>
<%- include('../partials/footer') %>
