<%- include('partials/header') %>
<div class="narrow">
  <h1>Нууц үг солих</h1>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/password" class="card form">
    <label>Одоогийн нууц үг
      <input name="current" type="password" autocomplete="current-password" required>
    </label>
    <label>Шинэ нууц үг <small class="muted">(6+ тэмдэгт)</small>
      <input name="password" type="password" minlength="6" autocomplete="new-password" required>
    </label>
    <label>Шинэ нууц үг давтах
      <input name="confirm" type="password" minlength="6" autocomplete="new-password" required>
    </label>
    <button class="btn btn-primary">Хадгалах</button>
  </form>
</div>
<%- include('partials/footer') %>
