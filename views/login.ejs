<%- include('partials/header', { bodyClass: 'auth-page' }) %>
<canvas id="login-bg" class="login-bg" aria-hidden="true"></canvas>

<div class="login-shell">
  <section class="login-hero">
    <div class="login-brand">
      <img src="/img/yesuvd-logo-720.png" alt="YeSuvd Learning Platform" class="login-logo" width="720" height="249">
    </div>
    <h1 class="login-title">Шалгалт, хичээл, даалгавар —<br><span>нэг дороос</span></h1>
    <p class="login-lede">Багш цагаа хэмнэж, сурагч өөрийн эрхээр суралцана. Дүн, анализ автоматаар гарна.</p>
    <ul class="login-points">
      <li><span class="dot"></span>Онлайн шалгалт, автомат дүгнэлт</li>
      <li><span class="dot"></span>Онол, слайд, даалгавар нэг хичээлд</li>
      <li><span class="dot"></span>Excel анализ, дүнгийн хүснэгт</li>
    </ul>
  </section>

  <section class="login-card" aria-labelledby="login-heading">
    <h2 id="login-heading">Нэвтрэх</h2>
    <p class="muted">Багш, сурагч өөрийн нэвтрэх нэр, нууц үгээр нэвтэрнэ.</p>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login" class="form" id="login-form">
      <label for="login-username">Нэвтрэх нэр</label>
      <input id="login-username" name="username" value="<%= username %>" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
      <label for="login-password">Нууц үг</label>
      <div class="password-field">
        <input id="login-password" name="password" type="password" autocomplete="current-password" required>
        <button type="button" class="password-toggle" id="password-toggle" aria-label="Нууц үг харуулах" aria-pressed="false">Харах</button>
      </div>
      <p class="caps-warning" id="caps-warning" hidden>Caps Lock асаалттай байна</p>
      <button class="btn btn-primary btn-block login-submit" id="login-submit">Нэвтрэх</button>
    </form>
    <p class="login-help muted small">Нэвтрэх нэр, нууц үгээ мартсан бол багш эсвэл админд хандана уу.</p>
  </section>
</div>

<script>
  (function () {
    var pw = document.getElementById('login-password');
    var toggle = document.getElementById('password-toggle');
    toggle.addEventListener('click', function () {
      var show = pw.type === 'password';
      pw.type = show ? 'text' : 'password';
      toggle.textContent = show ? 'Нуух' : 'Харах';
      toggle.setAttribute('aria-pressed', String(show));
      toggle.setAttribute('aria-label', show ? 'Нууц үг нуух' : 'Нууц үг харуулах');
      pw.focus();
    });
    var caps = document.getElementById('caps-warning');
    pw.addEventListener('keyup', function (e) { caps.hidden = !(e.getModifierState && e.getModifierState('CapsLock')); });
    pw.addEventListener('blur', function () { caps.hidden = true; });
    document.getElementById('login-form').addEventListener('submit', function () {
      var b = document.getElementById('login-submit');
      b.disabled = true;
      b.textContent = 'Нэвтэрч байна…';
    });
  })();
</script>
<%- include('partials/footer', { scripts: ['/js/login-scene.js'] }) %>
