# deploy/.env.example-ийг deploy/.env нэрээр хуулж утгуудаа бөглөнө.
# Нууц утгуудыг үүсгэх:  openssl rand -hex 32

# Домэйн (DNS A бичлэг нь энэ серверийн IP рүү заасан байх ёстой)
DOMAIN=learn.yesuvd.tech

# MongoDB (зөвхөн дотоод сүлжээнд). Нууц үгэнд зөвхөн үсэг, тоо ашиглана (hex тохиромжтой).
MONGO_USER=surgalt
MONGO_PASSWORD=

# Сессийн түлхүүр — хамгийн багадаа 32 тэмдэгт
SESSION_SECRET=

# Анхны админ (өгөгдлийн санд админ байхгүй үед л үүснэ). Нэвтэрсний дараа солино уу.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Нэг файлын дээд хэмжээ (MB)
MAX_FILE_MB=25

# Серверт 80/443 портыг өөр программ (nginx г.м.) эзэлсэн бол энд өөрчилнө
HTTP_PORT=80
HTTPS_PORT=443
