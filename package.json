{
  "name": "surgaltiin-system",
  "version": "0.1.0",
  "private": true,
  "description": "YeSuvd Learning Platform — багшийн үйл ажиллагааг автоматжуулах сургалтын систем",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.js",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/sync/deploy.ps1",
    "sync:pull": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/sync/pull.ps1",
    "sync:push": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/sync/push.ps1",
    "sync:restore-local": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/sync/restore-local.ps1",
    "judge:local": "powershell -NoProfile -ExecutionPolicy Bypass -File judge/run-local.ps1",
    "judge": "docker build -t surgalt-judge judge && docker run --rm --name surgalt-judge -p 127.0.0.1:5055:8000 --read-only --tmpfs /tmp:rw,exec,nosuid,size=512m --cap-drop ALL --cap-add SETUID --cap-add SETGID --cap-add KILL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --security-opt no-new-privileges --pids-limit 256 --memory 1536m surgalt-judge",
    "build:client": "esbuild client/login-scene.js client/rich-editor.js client/code-editor.js --bundle --minify --format=iife --target=es2019 --legal-comments=none --outdir=public/js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-mongo": "^6.0.0",
    "ejs": "^6.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "pptx-preview": "^1.0.7",
    "sanitize-html": "^2.17.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
